# 复制为 .env 后按需修改（可选）
# 后端监听：0.0.0.0 表示局域网内其他电脑也能访问
HOST=0.0.0.0
PORT=8000

# 手机 Web Push 密钥：运行 scripts/generate_vapid_keys.py 自动生成
# 私钥只放 .env 或部署平台环境变量，绝不提交到仓库
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@xiaoyi.local
# 自建推送服务时，把域名追加到允许列表（逗号分隔）
# PUSH_ALLOWED_HOSTS=push.example.com
